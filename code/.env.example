# -----------------------------------------------------------------------------
# Lab 9 environment.  cp .env.example .env  then fill in.
# Everything runs offline with --mock / --local if these are unset.
# -----------------------------------------------------------------------------

# --- Azure OpenAI for CrewAI (via LiteLLM). Note the AZURE_API_* names. ---
AZURE_API_KEY=YOUR-AOAI-KEY
AZURE_API_BASE=https://YOUR-AOAI-RESOURCE.openai.azure.com
AZURE_API_VERSION=2024-08-01-preview
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o

# --- Azure Service Bus (Lab 9-B) ---
SERVICEBUS_CONNECTION_STRING=Endpoint=sb://YOUR-NS.servicebus.windows.net/;SharedAccessKeyName=RootManageSharedAccessKey;SharedAccessKey=...
SERVICEBUS_QUEUE=agent-events

# --- Application Insights / Azure Monitor (telemetry; optional) ---
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=xxxx;IngestionEndpoint=https://...

# --- Optional: LangSmith tracing ---
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=YOUR-LANGSMITH-KEY
